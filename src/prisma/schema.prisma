generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model adicion {
  id         Int      @id @default(autoincrement())
  idventa    Int
  fechapago  DateTime @db.Timestamp(6)
  producto   String   @db.VarChar(255)
  categoria  String   @db.VarChar(255)
  cantidad   Int
  precio     Int
  costobase  Int
  costomodif Int
  costotot   Int
  creadopor  String   @db.VarChar(255)
  cocina     String   @db.VarChar(255)
  cancelada  String?  @db.VarChar(255)
  venta      venta    @relation(fields: [idventa], references: [idv], onDelete: Cascade, onUpdate: NoAction, map: "fk_venta")
}

model gasto {
  id         Int      @id @default(autoincrement())
  fecha      DateTime @db.Timestamp(6)
  giromes    String   @db.VarChar(255)
  item       String   @db.VarChar(255)
  monto      Int
}

model pago {
  id        Int      @id @default(autoincrement())
  idp       Int
  fecha     DateTime @db.Timestamp(6)
  mediopago String   @db.VarChar(255)
  monto     Int
  caja      String   @db.VarChar(255)
  sala      String?  @db.VarChar(255)
  mesa      Int?
  cancelado String?  @db.VarChar(255)
}

model usuario {
  id        Int       @id @default(autoincrement())
  username  String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  createdat DateTime? @default(now()) @db.Timestamp(6)
}

model venta {    
  idv        Int       @id @default(autoincrement())
  fecha      DateTime  @db.Timestamp(6)
  creacion   DateTime  @db.Timestamp(6)
  cerrada    DateTime  @db.Timestamp(6)
  caja       String    @db.VarChar(255)
  estado     String    @db.VarChar(255)
  mesa       Int?
  sala       String?   @db.VarChar(255)
  camarero   String?   @db.VarChar(255)
  mediopago  String?   @db.VarChar(255)
  total      Float     @db.Real
  tipoventa  String    @db.VarChar(255)
  adicion    adicion[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
}
